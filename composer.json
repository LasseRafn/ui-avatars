{
    "name": "lasserafn/ui-avatars",
    "description": "Generate avatars with initials from names",
    "type": "project",
    "license": "MIT",
    "require": {
        "lasserafn/php-initial-avatar-generator": "^4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LasseRafn\\UiAvatars\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LasseRafn\\UiAvatars\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
